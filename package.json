{
  "name": "janimeister-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "description": "Personal site for the Janimeister YouTube channel — FromSoftware boss kills.",
  "scripts": {
    "prebuild": "node --env-file-if-exists .env scripts/fetch-videos.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ci": "tsc -b && vite build",
    "build:e2e": "node scripts/copy-e2e-fixture.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "fetch:videos": "node --env-file-if-exists .env scripts/fetch-videos.mjs",
    "lint": "tsc -b --pretty",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "worker:dev": "wrangler dev worker/src/index.ts",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
